# Local USD web pilot configuration. Copy to .env and adjust as needed.
# .env is ignored by git; this template is tracked on purpose.

# Address and port the API binds to. Port 8766 belongs to the existing local
# SAM3 mask service and must not be reused.
NEMY_BIND=127.0.0.1
NEMY_PORT=8767

# Root directory for all mutable state: SQLite database, uploads, media,
# server secret, and logs.
NEMY_DATA_DIR=./data

# Upload guard rails.
NEMY_MAX_UPLOAD_BYTES=8589934592
NEMY_MAX_EXPANDED_BYTES=34359738368
NEMY_UPLOAD_CHUNK_BYTES=16777216

# Longest running ingest job, and the lifetime of a read-only media session.
NEMY_JOB_TIMEOUT_SECONDS=21600
NEMY_MEDIA_SESSION_SECONDS=900

# Absolute path to the pinned Spark `build-lod` executable. The API starts and
# reports converter "missing" while this is unset; ingest jobs fail with
# `converter_unavailable` until it points at a real executable.
# NEMY_BUILD_LOD=C:/path/to/build-lod.exe
